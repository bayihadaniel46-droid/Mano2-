<!DOCTYPE html>
<html lang="fr">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Paramètres - Mano2</title>

<script src="https://cdn.tailwindcss.com"></script>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

<link rel="stylesheet" href="/css/dark.css">

</head>

<body class="bg-gray-100">

<%- include("partials/mobile-header",{
    title:"Paramètres"
}) %>

<div class="max-w-7xl mx-auto py-10 px-6 pb-28">

<h1 class="text-5xl font-bold mb-10">

⚙️ Paramètres

</h1>

<div class="grid lg:grid-cols-4 gap-8">

<!-- Menu gauche -->

<div class="bg-white rounded-3xl shadow-lg p-6">

<h2 class="text-xl font-bold mb-6">

Navigation

</h2>

<div class="space-y-3">

<a href="/wallet"
class="block p-4 rounded-xl hover:bg-blue-50">

💰 Mon portefeuille

</a>

<a href="/professionnels"
class="block p-4 rounded-xl hover:bg-blue-50">

💼 Mes services

</a>

<a href="/"
class="block p-4 rounded-xl hover:bg-blue-50">

🏠 Retour à l'accueil

</a>

</div>

</div>

<!-- Contenu -->

<div class="lg:col-span-3 space-y-6">

<div class="bg-white rounded-3xl shadow-lg p-8">

<h2 class="text-2xl font-bold mb-6">

👤 Compte

</h2>

<div class="space-y-4">

<button
onclick="window.location='/edit-profile'"
class="w-full flex justify-between items-center p-5 bg-gray-100 rounded-2xl hover:bg-gray-200">

<span>profil</span>

<i class="fa-solid fa-chevron-right"></i>

</button>

</div>

</div>

<div class="bg-white rounded-3xl shadow-lg p-8">

<h2 class="text-2xl font-bold mb-6">

💼 Profession

</h2>

<div class="space-y-4">

<button
class="w-full flex justify-between items-center p-5 bg-gray-100 rounded-2xl">

<span>Modifier mon métier</span>

<i class="fa-solid fa-chevron-right"></i>

</button>

<button
class="w-full flex justify-between items-center p-5 bg-gray-100 rounded-2xl">

<span>Modifier ma description</span>

<i class="fa-solid fa-chevron-right"></i>

</button>

<button
class="w-full flex justify-between items-center p-5 bg-gray-100 rounded-2xl">

<span>Modifier ma ville</span>

<i class="fa-solid fa-chevron-right"></i>

</button>

</div>

</div>

<div class="bg-white rounded-3xl shadow-lg p-8">

<h2 class="text-2xl font-bold mb-6">

🔔 Notifications

</h2>

<div class="flex justify-between items-center mb-5">

<span>Recevoir les nouveaux messages</span>

<input
type="checkbox"
checked
class="w-6 h-6">

</div>

<div class="flex justify-between items-center">

<span>Recevoir les nouvelles demandes</span>

<input
type="checkbox"
checked
class="w-6 h-6">

</div>

</div>

<div class="bg-white rounded-3xl shadow-lg p-8">

<h2 class="text-2xl font-bold mb-6">

🛡️ Confidentialité

</h2>

<div class="space-y-4">

<button
class="w-full flex justify-between items-center p-5 bg-gray-100 rounded-2xl">

<span>Qui peut voir mon profil ?</span>

<span>Public</span>

</button>

<button
class="w-full flex justify-between items-center p-5 bg-gray-100 rounded-2xl">

<span>Masquer mon téléphone</span>

<span>OFF</span>

</button>

</div>

</div>

<div class="bg-white rounded-3xl shadow-lg p-8">

<button
onclick="window.location='/logout'"
class="w-full bg-red-600 hover:bg-red-700 text-white py-4 rounded-2xl text-xl font-bold">

🚪 Déconnexion

</button>

</div>

</div>

</div>

</div>

<div class="h-20 lg:hidden"></div>

<%- include("partials/mobile-nav", { activePage: "settings" }) %>

</body>

</html>