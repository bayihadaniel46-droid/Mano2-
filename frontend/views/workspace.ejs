<!DOCTYPE html>
<html lang="fr">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Mon espace professionnel</title>

<script src="https://cdn.tailwindcss.com"></script>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

<link rel="stylesheet" href="/css/dark.css">

</head>

<body class="bg-gray-100">

<div class="max-w-6xl mx-auto py-10 px-5">

<div class="flex items-center justify-between mb-10">

<div class="flex items-center gap-4">

<button
onclick="history.back()"
class="w-12 h-12 bg-white rounded-xl shadow">

<i class="fa fa-arrow-left"></i>

</button>

<div>

<h1 class="text-3xl font-bold">

Mon espace professionnel

</h1>

<p class="text-gray-500">

Bienvenue <%= user.nom %>

</p>

</div>

</div>

</div>


<div class="grid lg:grid-cols-3 gap-8">

<!-- PROFIL -->

<div class="bg-white rounded-3xl shadow-lg p-8">

<div class="text-center">

<div class="w-32 h-32 rounded-full bg-gray-200 mx-auto flex items-center justify-center">

<i class="fa fa-user text-5xl text-gray-500"></i>

</div>

<h2 class="text-3xl font-bold mt-6">

<%= user.nom %>

</h2>

<p class="text-gray-500 mt-2">

<%= user.metier %>

</p>

<p class="mt-2">

📍 <%= user.ville %>

</p>

</div>

<div class="mt-8">

<div class="flex justify-between mb-2">

<span>Profil complété</span>

<span>65%</span>

</div>

<div class="w-full h-4 bg-gray-200 rounded-full">

<div class="h-4 bg-green-500 rounded-full w-2/3"></div>

</div>

</div>

</div>

<!-- ACTIONS -->

<div class="lg:col-span-2">

<div class="grid md:grid-cols-2 gap-6">

<a href="/edit-profile"

class="bg-white rounded-3xl shadow-lg p-8 hover:shadow-xl transition">

<div class="text-5xl">

✏️

</div>

<h2 class="text-2xl font-bold mt-5">

Modifier mon profil

</h2>

<p class="text-gray-500 mt-3">

Modifier vos informations.

</p>

</a>

<a href="/gallery"

class="bg-white rounded-3xl shadow-lg p-8 hover:shadow-xl transition">

<div class="text-5xl">

📷

</div>

<h2 class="text-2xl font-bold mt-5">

Mes photos

</h2>

<p class="text-gray-500 mt-3">

Ajouter vos réalisations.

</p>

</a>

<a href="/reviews"

class="bg-white rounded-3xl shadow-lg p-8 hover:shadow-xl transition">

<div class="text-5xl">

⭐

</div>

<h2 class="text-2xl font-bold mt-5">

Mes avis

</h2>

<p class="text-gray-500 mt-3">

Consulter les notes.

</p>

</a>

<a href="/wallet"

class="bg-white rounded-3xl shadow-lg p-8 hover:shadow-xl transition">

<div class="text-5xl">

💰

</div>

<h2 class="text-2xl font-bold mt-5">

Mon portefeuille

</h2>

<p class="text-gray-500 mt-3">

Voir vos revenus.

</p>

</a>

<a href="/notifications"

class="bg-white rounded-3xl shadow-lg p-8 hover:shadow-xl transition">

<div class="text-5xl">

🔔

</div>

<h2 class="text-2xl font-bold mt-5">

Notifications

</h2>

<p class="text-gray-500 mt-3">

Voir les nouveautés.

</p>

</a>

<a href="/professionnels"

class="bg-white rounded-3xl shadow-lg p-8 hover:shadow-xl transition">

<div class="text-5xl">

🌍

</div>

<h2 class="text-2xl font-bold mt-5">

Explorer Mano2

</h2>

<p class="text-gray-500 mt-3">

Trouver des professionnels.

</p>

</a>

</div>

</div>

</div>

<!-- APERÇU -->

<div class="bg-white rounded-3xl shadow-lg mt-10 p-8">

<h2 class="text-3xl font-bold mb-8">

Aperçu de votre profil

</h2>

<div class="grid md:grid-cols-2 gap-6">

<div>

<p class="text-gray-500">

Nom

</p>

<p class="font-bold">

<%= user.nom %>

</p>

</div>

<div>

<p class="text-gray-500">

Métier

</p>

<p class="font-bold">

<%= user.metier %>

</p>

</div>

<div>

<p class="text-gray-500">

Ville

</p>

<p class="font-bold">

<%= user.ville %>

</p>

</div>

<div>

<p class="text-gray-500">

Téléphone

</p>

<p class="font-bold">

<%= user.telephone %>

</p>

</div>

</div>

<div class="mt-8">

<p class="text-gray-500">

Description

</p>

<p class="mt-3">

<%= user.description %>

</p>

</div>

</div>

</div>

</body>

</html>