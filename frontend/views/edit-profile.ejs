<!DOCTYPE html>
<html lang="fr">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Modifier mon profil</title>

<script src="https://cdn.tailwindcss.com"></script>

<link rel="stylesheet" href="/css/dark.css">

</head>

<body class="bg-gray-100">

<%- include("partials/mobile-header",{title:"Modifier mon profil"}) %>

<div class="max-w-3xl mx-auto mt-8">

<div class="bg-white rounded-3xl shadow-xl p-8">

<h1 class="text-3xl font-bold mb-8">

Modifier mon profil

</h1>

<form action="/update-profile" method="POST" class="space-y-6">

<div>

<label class="font-semibold block mb-2">

Nom complet

</label>

<input
type="text"
name="nom"
value="<%= user.nom %>"
class="w-full border rounded-xl p-4">

</div>

<div>

<label class="font-semibold block mb-2">

Métier

</label>

<input
type="text"
name="metier"
value="<%= user.metier %>"
class="w-full border rounded-xl p-4">

</div>

<div>

<label class="font-semibold block mb-2">

Ville

</label>

<input
type="text"
name="ville"
value="<%= user.ville %>"
class="w-full border rounded-xl p-4">

</div>

<div>

<label class="font-semibold block mb-2">

Téléphone

</label>

<input
type="text"
name="telephone"
value="<%= user.telephone %>"
class="w-full border rounded-xl p-4">

</div>

<div>

<label class="font-semibold block mb-2">

Adresse email

</label>

<input
type="email"
name="email"
value="<%= user.email %>"
class="w-full border rounded-xl p-4">

</div>

<div>

<label class="font-semibold block mb-2">

Description

</label>

<textarea
name="description"
rows="6"
class="w-full border rounded-xl p-4"><%= user.description %></textarea>

</div>

<div class="flex gap-4">

<button
class="bg-green-600 text-white px-8 py-4 rounded-2xl">

💾 Enregistrer

</button>

<a
href="/"
class="bg-gray-300 px-8 py-4 rounded-2xl">

Annuler

</a>

</div>

</form>

</div>

</div>

</body>
</html>