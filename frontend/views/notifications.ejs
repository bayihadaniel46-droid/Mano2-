<!DOCTYPE html>
<html lang="fr">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Notifications - Mano2</title>

<script src="https://cdn.tailwindcss.com"></script>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

<link rel="stylesheet" href="/css/dark.css">

</head>

<body class="bg-gray-100">

<!-- Header -->

<%- include("partials/mobile-header",{
title:"Notifications"
}) %>

<div class="max-w-3xl mx-auto p-4">

<!-- Bouton -->

<div class="flex justify-end mb-5">

<button
class="px-4 py-2 rounded-xl bg-blue-600 text-white">

Tout marquer comme lu

</button>

</div>

<!-- AUJOURD'HUI -->

<h2 class="text-gray-500 font-bold mb-3">

Aujourd'hui

</h2>

<!-- Notification -->

<div class="bg-white rounded-3xl shadow p-5 mb-4">

<div class="flex">

<div class="w-14 h-14 rounded-full bg-blue-100 flex items-center justify-center">

<i class="fa-solid fa-envelope text-blue-600 text-xl"></i>

</div>

<div class="ml-4 flex-1">

<h3 class="font-bold">

Nouveau message

</h3>

<p class="text-gray-600 mt-1">

Jean Dupont vous a envoyé un message.

</p>

<p class="text-sm text-gray-400 mt-2">

Il y a 2 minutes

</p>

</div>

</div>

</div>

<div class="bg-white rounded-3xl shadow p-5 mb-4">

<div class="flex">

<div class="w-14 h-14 rounded-full bg-green-100 flex items-center justify-center">

<i class="fa-solid fa-user-plus text-green-600 text-xl"></i>

</div>

<div class="ml-4 flex-1">

<h3 class="font-bold">

Nouvelle demande

</h3>

<p class="text-gray-600 mt-1">

Marie souhaite vous contacter.

</p>

<p class="text-sm text-gray-400 mt-2">

Il y a 15 minutes

</p>

</div>

</div>

</div>

<!-- HIER -->

<h2 class="text-gray-500 font-bold mt-8 mb-3">

Hier

</h2>

<div class="bg-white rounded-3xl shadow p-5 mb-4">

<div class="flex">

<div class="w-14 h-14 rounded-full bg-yellow-100 flex items-center justify-center">

<i class="fa-solid fa-star text-yellow-500 text-xl"></i>

</div>

<div class="ml-4 flex-1">

<h3 class="font-bold">

Votre profil est populaire

</h3>

<p class="text-gray-600 mt-1">

12 personnes ont consulté votre profil.

</p>

<p class="text-sm text-gray-400 mt-2">

Hier à 20:30

</p>

</div>

</div>

</div>

<div class="bg-white rounded-3xl shadow p-5 mb-4">

<div class="flex">

<div class="w-14 h-14 rounded-full bg-purple-100 flex items-center justify-center">

<i class="fa-solid fa-circle-info text-purple-600 text-xl"></i>

</div>

<div class="ml-4 flex-1">

<h3 class="font-bold">

Bienvenue sur Mano2

</h3>

<p class="text-gray-600 mt-1">

Complétez votre profil pour attirer plus de clients.

</p>

<p class="text-sm text-gray-400 mt-2">

Hier à 10:12

</p>

</div>

</div>

</div>

</div>

<!-- Espace pour la barre mobile -->

<div class="h-24 lg:hidden"></div>

<!-- Barre de navigation -->

<%- include("partials/mobile-nav",{
activePage:"notifications"
}) %>

</body>

</html>