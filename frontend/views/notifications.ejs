<!-- views/notifications.ejs -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notifications - Mano2</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
  <link rel="stylesheet" href="/css/dark.css">
</head>
<body class="bg-gray-100">

<%- include("partials/mobile-header", { title: "Notifications" }) %>

<div class="max-w-3xl mx-auto p-4" id="notifications-app">
  <%
  const icons = {

    message: {
      icon: "fa-message",
      color: "text-blue-600",
      bg: "bg-blue-100"
    },

    review: {
      icon: "fa-star",
      color: "text-yellow-600",
      bg: "bg-yellow-100"
    },

    profile: {
      icon: "fa-user",
      color: "text-green-600",
      bg: "bg-green-100"
    },

    wallet: {
      icon: "fa-wallet",
      color: "text-purple-600",
      bg: "bg-purple-100"
    },

    system: {
      icon: "fa-bell",
      color: "text-gray-600",
      bg: "bg-gray-100"
    }

  };
  %>

  <!-- En-tête -->
  <div class="flex items-center justify-between mb-5">
    <div>
      <p class="text-sm text-gray-500">
        <% if (unreadCount > 0) { %>
          <span id="unread-badge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
            <%= unreadCount %> non lue<%= unreadCount > 1 ? 's' : '' %>
          </span>
        <% } %>
      </p>
    </div>
    <% if (unreadCount > 0) { %>
      <button id="mark-all-btn"
        class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition">
        Tout marquer comme lu
      </button>
    <% } %>
  </div>

  <% const total = grouped.today.length + grouped.yesterday.length + grouped.older.length; %>

  <% if (total === 0) { %>
    <!-- État vide -->
    <div class="bg-white rounded-3xl shadow p-12 text-center">
      <div class="w-16 h-16 mx-auto rounded-full bg-gray-100 flex items-center justify-center mb-4">
        <i class="fa-regular fa-bell-slash text-gray-400 text-2xl"></i>
      </div>
      <h3 class="font-bold text-gray-800">Aucune notification</h3>
      <p class="text-gray-500 mt-2 text-sm">Vous serez prévenu ici des nouveaux messages et activités.</p>
    </div>
  <% } else { %>
    <% const sections = [
      { key: 'today', label: "Aujourd'hui" },
      { key: 'yesterday', label: 'Hier' },
      { key: 'older', label: 'Plus ancien' }
    ]; %>

    <% sections.forEach(section => { %>
      <% if (grouped[section.key].length > 0) { %>
        <h2 class="text-gray-500 font-bold mb-3 mt-<%= section.key === 'today' ? '0' : '8' %>">
          <%= section.label %>
        </h2>

        <% grouped[section.key].forEach(n => {
          const style = icons[n.type] || icons.system;
        %>
          <a href="<%= n.link || '#' %>"
             data-id="<%= n._id %>"
             class="notification-item block bg-white rounded-3xl shadow p-5 mb-4 transition hover:shadow-md <%= !n.isRead ? 'ring-2 ring-blue-100' : '' %>">
            <div class="flex items-start">
              <div class="w-14 h-14 rounded-full <%= style.bg %> flex items-center justify-center shrink-0">
                <i class="fa-solid <%= style.icon %> <%= style.color %> text-xl"></i>
              </div>
              <div class="ml-4 flex-1 min-w-0">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="font-bold text-gray-900 <%= !n.isRead ? '' : 'font-semibold' %>">
                    <%= n.title %>
                  </h3>
                  <% if (!n.isRead) { %>
                    <span class="unread-dot w-2.5 h-2.5 rounded-full bg-blue-600 shrink-0 mt-1.5"></span>
                  <% } %>
                </div>
                <p class="text-gray-600 mt-1 text-sm"><%= n.message %></p>
                <p class="text-xs text-gray-400 mt-2"><%= n.relativeTime %></p>
              </div>
            </div>
          </a>
        <% }); %>
      <% } %>
    <% }); %>

  <% } %>
</div>

<div class="h-24 lg:hidden"></div>
<%- include("partials/mobile-nav", { activePage: "notifications" }) %>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const markAllBtn = document.getElementById('mark-all-btn');

  markAllBtn?.addEventListener('click', async () => {
    markAllBtn.disabled = true;
    markAllBtn.textContent = 'Traitement...';
    try {
      await fetch('/notifications/mark-all-read', { method: 'POST' });
      document.querySelectorAll('.notification-item').forEach(el => {
        el.classList.remove('ring-2', 'ring-blue-100');
        el.querySelector('.unread-dot')?.remove();
      });
      document.getElementById('unread-badge')?.remove();
      markAllBtn.remove();
    } catch {
      markAllBtn.disabled = false;
      markAllBtn.textContent = 'Tout marquer comme lu';
    }
  });

  document.querySelectorAll('.notification-item[data-id]').forEach(item => {
    item.addEventListener('click', async (e) => {
      const id = item.dataset.id;
      if (!id || item.href === '#') return;
      fetch(`/notifications/${id}/read`, { method: 'POST' }).catch(() => {});
    });
  });
});
</script>
</body>
</html>