<script>

AOS.init();

async function chargerCategories() {

    const menu = document.getElementById("menuCategories");

    try {

        const reponse = await fetch("/categories");

        const categories = await reponse.json();

        if(categories.length === 0){

            menu.innerHTML = `
                <p class="text-gray-500">
                    Aucune catégorie disponible
                </p>
            `;

            return;

        }

        menu.innerHTML = "";

        categories.forEach(cat => {

            menu.innerHTML += `

                <a
                href="/search-results?metier=${encodeURIComponent(cat.metier)}"
                class="flex justify-between p-3 rounded-xl hover:bg-gray-100">

                    <span>${cat.metier}</span>

                    <span class="text-blue-600 font-bold">

                        ${cat.total}

                    </span>

                </a>

            `;

        });

    }

    catch(error){

        menu.innerHTML = `
            <p class="text-red-500">
                Impossible de charger les catégories.
            </p>
        `;

        console.error(error);

    }

}

chargerCategories();

</script>
<script>

const btn = document.getElementById("btnCategories");
const menu = document.getElementById("menuCategories");

btn.onclick = async () => {

    if(menu.classList.contains("hidden")){

        const res = await fetch("/categories");
        const data = await res.json();

        menu.innerHTML = "";

        data.forEach(cat=>{

            menu.innerHTML += `
                <a
                href="/search-results?metier=${encodeURIComponent(cat.metier)}"
                class="block px-5 py-3 hover:bg-gray-100">

                    ${cat.metier}
                    (${cat.total})

                </a>
            `;

        });

        menu.classList.remove("hidden");

    }

    else{

        menu.classList.add("hidden");

    }

}

document.addEventListener("click",(e)=>{

    if(!btn.contains(e.target) && !menu.contains(e.target)){

        menu.classList.add("hidden");

    }

});
</script>
<script>

const mobileMenuButton = document.getElementById("mobileMenuButton");

const mobileDrawer = document.getElementById("mobileDrawer");

const closeDrawer = document.getElementById("closeDrawer");

const overlay = document.getElementById("overlay");

mobileMenuButton.addEventListener("click", () => {

    mobileDrawer.classList.remove("-translate-x-full");

    overlay.classList.remove("hidden");

});

closeDrawer.addEventListener("click", () => {

    mobileDrawer.classList.add("-translate-x-full");

    overlay.classList.add("hidden");

});

overlay.addEventListener("click", () => {

    mobileDrawer.classList.add("-translate-x-full");

    overlay.classList.add("hidden");

});

</script>
